# Preserve user-created scenes, scripts and assets on subsequent editor builds.
if(NOT EXISTS "${DEST}/scene.json")
    file(MAKE_DIRECTORY "${DEST}")
    file(COPY "${SRC}/" DESTINATION "${DEST}")
else()
    # Upgrade default projects made with Option A. Never overwrite modified scripts.
    file(MAKE_DIRECTORY "${DEST}/scripts")
    if(NOT EXISTS "${DEST}/behaviors.json")
        file(COPY_FILE "${SRC}/behaviors.json" "${DEST}/behaviors.json")
        foreach(script MoveWithKeys.cpp Spin.cpp Patrol.cpp)
            if(NOT EXISTS "${DEST}/scripts/${script}")
                file(COPY_FILE "${SRC}/scripts/${script}" "${DEST}/scripts/${script}")
            endif()
        endforeach()
    endif()
endif()
